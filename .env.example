# ==============================================
# Supremo Discord Bot - Environment Variables
# ==============================================

# Copy this file to .env and fill in your values
# Never commit .env files to version control!

# ==============================================
# Database Configuration
# ==============================================
DB_NAME=supremo_db
DB_USER=supremo
DB_PASSWORD=your_secure_database_password_here
DB_HOST=localhost
DB_PORT=5432

# Full database URL (alternative to individual DB vars)
# DATABASE_URL="postgresql://supremo:password@localhost:5432/supremo_db"

# ==============================================
# Redis Configuration (Optional but Recommended)
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here
# REDIS_URL="redis://:password@localhost:6379"

# ==============================================
# Discord Configuration
# ==============================================
# Get these from https://discord.com/developers/applications

# Your Discord Bot Token
DISCORD_TOKEN=your_discord_bot_token_here

# Discord OAuth Application
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here

# ==============================================
# JWT Configuration
# ==============================================
# Generate a secure random string (32+ characters)
JWT_SECRET=your_super_secure_jwt_secret_key_here_32_chars_minimum
JWT_EXPIRES_IN=7d

# ==============================================
# Application Configuration
# ==============================================
NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_PORT=3000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# ==============================================
# Frontend Configuration
# ==============================================
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001

# Discord OAuth Redirect
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id_here
NEXT_PUBLIC_DISCORD_REDIRECT_URI=http://localhost:3000/auth/callback

# App Branding
NEXT_PUBLIC_APP_NAME=Supremo Bot
NEXT_PUBLIC_APP_VERSION=1.0.0

# ==============================================
# Logging Configuration
# ==============================================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# ==============================================
# Security Configuration
# ==============================================
# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Session Configuration
SESSION_SECRET=your_session_secret_here

# ==============================================
# External Services (Optional)
# ==============================================
# Sentry Error Tracking
# SENTRY_DSN=your_sentry_dsn_here

# Webhook URLs for notifications
# WEBHOOK_ERROR_URL=your_error_webhook_url
# WEBHOOK_AUDIT_URL=your_audit_webhook_url

# ==============================================
# Development Configuration
# ==============================================
# Set to true to enable development features
DEBUG=false
ENABLE_SWAGGER=true

# Database seeding
SEED_DATABASE=false

# ==============================================
# Production Configuration
# ==============================================
# SSL Configuration (Production only)
# SSL_CERT_PATH=/path/to/ssl/cert.pem
# SSL_KEY_PATH=/path/to/ssl/private.key

# Domain Configuration (Production only)
# DOMAIN=your-domain.com
# SUBDOMAIN=bot

# CDN Configuration (Production only)
# CDN_URL=https://cdn.your-domain.com

# ==============================================
# Monitoring & Analytics (Optional)
# ==============================================
# Application Performance Monitoring
# APM_SERVICE_NAME=supremo-bot
# APM_SERVER_URL=your_apm_server_url

# Metrics Collection
# METRICS_ENABLED=true
# METRICS_PORT=9090

# ==============================================
# Backup Configuration (Optional)
# ==============================================
# Database Backup
# BACKUP_ENABLED=true
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
# BACKUP_RETENTION_DAYS=30

# S3 Backup Storage (Optional)
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-backup-bucket

# ==============================================
# Feature Flags (Optional)
# ==============================================
# Enable/disable specific features
FEATURE_ANALYTICS=true
FEATURE_AUTOMATION=true
FEATURE_ANTI_RAID=true
FEATURE_TRUST_SYSTEM=true
FEATURE_TICKETS=true
FEATURE_WORKFLOWS=true

# ==============================================
# Notes
# ==============================================
# 1. Replace all "your_*_here" values with actual values
# 2. Generate secure random strings for secrets
# 3. Use strong passwords for database and Redis
# 4. Keep this file secure and never commit to version control
# 5. For production, use environment-specific values