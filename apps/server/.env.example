# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supremo_bot?schema=public

# Discord
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
# Must match Discord Developer Portal redirect URL (points at this API).
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback

# Redis (Required)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Process Type
PROCESS_TYPE=all  # Options: 'api', 'bot', 'all'

# API Server
API_PORT=3001
WS_PORT=3003
# Where the Next.js app runs (OAuth browser redirect after GET /api/auth/discord/callback).
WEB_URL=http://localhost:7634
# Browsers call the API from the web origin — include both during local dev.
CORS_ORIGINS=http://localhost:7634,http://localhost:3001
# Optional: force session cookie Secure (defaults true when NODE_ENV=production)
# COOKIE_SECURE=false

# ML/AI (Optional)
PERSPECTIVE_API_KEY=
PERSPECTIVE_ENABLED=false
ML_CONFIDENCE_THRESHOLD=70

# Security
SESSION_SECRET=change_me_to_a_random_32_character_secret
NODE_ENV=development
LOG_LEVEL=info
