// ML Training Data for Learning System
// Note: AuditLog already exists, will be enhanced in migration
model MLTrainingData {
  id                String   @id @default(uuid())
  incidentType      String
  features           Json     // Incident features
  botConfidence      Float
  botRecommendation  Json     // Bot's recommended action
  moderatorAction    String   // 'approved', 'rejected', 'modified'
  outcome            String   // 'effective', 'too_harsh', 'too_lenient', 'false_positive'
  context            Json?    // Additional context
  createdAt          DateTime @default(now())

  @@index([incidentType])
  @@index([outcome])
  @@index([createdAt])
  @@map("ml_training_data")
}
